# Copy this file outside the repository, normally to:
#   ~/.config/dacbar/release.secrets
#
# Use literal values after '='; this file is parsed as data and is never sourced.
# Do not add shell quotes or expansions. Paths must be absolute.
BUILD_CERTIFICATE_P12=/secure/path/DeveloperID.p12
P12_PASSWORD=
NOTARY_APPLE_ID=
NOTARY_PASSWORD=
SPARKLE_PRIVATE_KEY_FILE=/secure/path/dacbar-sparkle-private-key
DSYM_ARCHIVE_PASSWORD=
