{
  "sourceLanguage" : "en",
  "strings" : {
    "error.device-not-found" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Device not found." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未找到设备。" } } } },
    "error.device-removed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The device was disconnected." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备已断开。" } } } },
    "error.device-timeout" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The device did not respond." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备无响应。" } } } },
    "error.hid-unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to access the HID subsystem (0x%08X)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法访问 HID 子系统 (0x%08X)。" } } } },
    "error.invalid-frame" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The device returned invalid data." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备返回了无效数据。" } } } },
    "error.invalid-wire-value" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Value 0x%1$02X is outside the range for command 0x%2$02X." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "命令 0x%2$02X 的值 0x%1$02X 超出范围。" } } } },
    "error.write-failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Write failed (0x%08X)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入失败 (0x%08X)。" } } } },
    "filter.explanation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digital audio is a series of discrete samples. This filter controls how the signal is reconstructed between them and removes ultrasonic imaging.\n\nEach option trades cleaner filtering against preserving transient shape. The first four are subtle; non-oversampling is usually the only clearly audible choice." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "数字音乐是一串离散的采样点。这个滤波器决定采样点之间的形状怎么补出来，并滤掉采样带来的超声杂散。\n\n各档是在「滤得干净」和「尽量不改变起音形状」之间取舍。前四档差别很细微，盲听多半分辨不出；非过采样是唯一能明显听出来的一档。" } } } },
    "filter.linear-fast" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Linear phase, fast roll-off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "线性相位 快速滚降" } } } },
    "filter.linear-fast.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The most neutral option and the strongest suppression of digital artifacts. Transients can have very slight ringing before and after them. This is the usual default." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听感最中性。数字失真抑制最彻底，代价是鼓点这类起音的前后都有极轻微的拖尾。多数解码器的默认档。" } } } },
    "filter.linear-slow" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Linear phase, slow roll-off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "线性相位 慢速滚降" } } } },
    "filter.linear-slow.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Slightly softer treble, with less ringing and a small loss at the top of the audible range." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高频稍柔。拖尾比上一档少，最高频段有轻微损失。" } } } },
    "filter.minimum-fast" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Minimum phase, fast roll-off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最小相位 快速滚降" } } } },
    "filter.minimum-fast.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sharper transients. Ringing occurs only after the transient, as it does with acoustic instruments." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "起音更干脆。拖尾只在声音之后，不会出现在之前——真实乐器就是这样。" } } } },
    "filter.minimum-slow" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Minimum phase, slow roll-off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最小相位 慢速滚降" } } } },
    "filter.minimum-slow.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The most relaxed and softest treble, with the least ringing and the greatest high-frequency loss." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最松弛、高频最柔。拖尾最少，高频损失也最多。" } } } },
    "filter.nos" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Non-oversampling / bypass" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "非过采样 / 旁路" } } } },
    "filter.nos.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Noticeably warmer and more analog-like. It skips digital filtering, rolling off more treble while leaving more digital artifacts." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "明显偏暖，带点「模拟味」。完全不做数字滤波，高频收得多，数字失真也不再被抑制。" } } } },
    "settings.balance" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Balance" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "平衡" } } } },
    "settings.brightness" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Brightness" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "亮度" } } } },
    "settings.filter" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Filter" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "滤波器" } } } },
    "settings.gain" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Gain" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "增益" } } } },
    "settings.gain.high" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高增益" } } } },
    "settings.gain.low" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Low" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "低增益" } } } },
    "settings.orientation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Orientation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "方向" } } } },
    "settings.screen-offset" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen offset" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕偏移" } } } },
    "settings.screen-timeout" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen timeout" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "息屏" } } } },
    "settings.screen-timeout.never" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Always on" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "常亮" } } } },
    "settings.screen-timeout.seconds" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld sec" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 秒" } } } },
    "settings.volume" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Volume" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音量" } } } }
  },
  "version" : "1.0"
}
